@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")

find_dependency(SDL3 CONFIG)
find_dependency(PNG)
find_dependency(SDL3_image CONFIG)
find_dependency(SDL3_ttf CONFIG)
find_dependency(SDL3_mixer CONFIG)
find_dependency(box2d CONFIG)
find_dependency(spdlog CONFIG)
find_dependency(pugixml CONFIG)
find_dependency(zstd CONFIG)
find_dependency(TMXLITE MODULE)

include("${CMAKE_CURRENT_LIST_DIR}/KrakenEngineTargets.cmake")

check_required_components(KrakenEngine)
